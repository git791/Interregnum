# Nebius Token Factory API Key
NEBIUS_API_KEY=

# Tavily API Key (Bonus: Best Use of Tavily)
TAVILY_API_KEY=

# Database Connection URL (Supabase or Neon Postgres)
DATABASE_URL=

# NemoClaw / Hermes Sandbox
SANDBOX_API_URL=        # Cloudflare Tunnel URL -> Hermes :8642
SANDBOX_API_TOKEN=      # Bearer token from `nemohermes <name> gateway-token --quiet`

# Application Base URL
APP_BASE_URL=http://localhost:3000

# Email Sink / Provider (Optional for demo notifications)
RESEND_API_KEY=
